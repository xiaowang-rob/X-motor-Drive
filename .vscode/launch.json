{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试（跟随 project.json）",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/firmware/build/current.elf",
            "servertype": "openocd",
            "gdbPath": "arm-none-eabi-gdb",
            "objdumpPath": "arm-none-eabi-objdump",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "preLaunchTask": "编译",
            "configFiles": [
                "${workspaceFolder}/firmware/build/debug_openocd.cfg"
            ]
        }
    ]
}
