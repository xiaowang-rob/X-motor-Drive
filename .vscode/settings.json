{
    "cortex-debug.variableUseNaturalFormat": true,
    "cmake.sourceDirectory": "${workspaceFolder}/firmware",
    "C_Cpp.errorSquiggles": "enabled",
    "python-envs.defaultEnvManager": "ms-python.python:system",
    // ---------- 全局基础开关 ----------
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": true,
    // ---------- C / C++ ----------
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, IndentWidth: 4, ColumnLimit: 80, BinPackArguments: false }",
    "C_Cpp.clang_format_style": "file",
    // ---------- Python ----------
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter" // 或 "ms-python.autopep8"
    },
    "python.formatting.provider": "black", // 旧版兼容，部分配置仍依赖此项
    // ---------- JSON ----------
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    // ---------- Task Buttons 状态栏按钮 ----------
    // 插件按 label 精确匹配 tasks.json 中的任务，图标写在 label 的 $(icon-name) 中
    "VsCodeTaskButtons.tasks": [
        {
            "label": "$(gear) 编译",
            "task": "编译",
            "tooltip": "编译（板卡/类型取 project.json）"
        },
        {
            "label": "$(debug-rerun) 重编译",
            "task": "重编译",
            "tooltip": "清理并重新编译"
        },
        {
            "label": "$(zap) 烧录",
            "task": "烧录",
            "tooltip": "烧录当前固件"
        },
        {
            "label": "$(rocket) 编译并烧录",
            "task": "编译并烧录",
            "tooltip": "编译并烧录"
        },
        {
            "label": "$(trash) 擦除",
            "task": "擦除",
            "tooltip": "擦除芯片"
        },
        {
            "label": "$(clear-all) 清理",
            "task": "清理",
            "tooltip": "删除 build/ 目录"
        },
        {
            "label": "$(play) 上位机",
            "task": "上位机",
            "tooltip": "启动上位机"
        }
    ],
    "better-todo-tree.general.tags": [
        "TODO",
        "FIXME",
        "BUG",
        "HACK",
        "NOTE"
    ],
    "better-todo-tree.filtering.excludeGlobs": [
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/.git/**"
    ],
    "better-todo-tree.general.statusBar": "tags",
    "better-todo-tree.general.showActivityBarBadge": true,
    "better-todo-tree.highlights.defaultHighlight": {
        "icon": "alert",
        "type": "text",
        "foreground": "#F00",
        "background": "#FFF",
        "opacity": 50,
        "iconColour": "#00F"
    },
    "better-todo-tree.highlights.customHighlight": {
        "TODO": {
            "icon": "check",
            "type": "line"
        },
        "FIXME": {
            "foreground": "#000",
            "iconColour": "#FF0",
            "gutterIcon": true
        }
    }
}