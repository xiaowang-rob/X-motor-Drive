{
    // 标准 VS Code 任务定义。Task Buttons 插件按 label 调用任务，
    // 按钮外观（图标 / tooltip / 对齐）在 settings.json 的 VsCodeTaskButtons.tasks 中配置。
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/firmware/build_tools/build.py",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "重编译",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/firmware/build_tools/build.py",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "清理"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "烧录",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/firmware/build_tools/build.py",
                "flash"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "编译并烧录",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/firmware/build_tools/build.py",
                "bf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "擦除",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/firmware/build_tools/build.py",
                "erase"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "清理",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/firmware/build_tools/build.py",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "CheckAndFlash",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/firmware/build_tools/check_flash.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "上位机",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/software/start.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}